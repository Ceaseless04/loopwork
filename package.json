{
  "name": "loopwork",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs --project unit",
    "test:pg": "vitest run --project pg --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "check:fast": "pnpm typecheck && pnpm lint && gitleaks detect --redact --no-banner && scripts/floor-guard.sh",
    "check:task": "pnpm check:fast && pnpm test --coverage && depcruise --validate",
    "check:full": "pnpm check:task && pnpm test:pg && pnpm test:e2e && semgrep scan --config p/default --config p/typescript --error && osv-scanner scan source -r .",
    "check:arch": "depcruise . --validate"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
