+import type { Node } from './types.js';
+
+export function ids(nodes: Node[]): string[] {
+  try {
+    return nodes.map((n) => n.id);
+  } catch (error) {
+    process.stderr.write(`ids failed: ${String(error)}\n`);
+    return [];
+  }
+}
